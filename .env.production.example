# ════════════════════════════════════════════════════════════════
# CPAP WEB - Configuración para PRODUCCIÓN
# ════════════════════════════════════════════════════════════════
# Copia este archivo a .env y actualiza con tus valores reales
# ════════════════════════════════════════════════════════════════

# ─── APLICACIÓN ───────────────────────────────────────────────────
APP_NAME="CPAP Web"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tu-dominio.com
APP_TIMEZONE=America/Lima

# ─── LARAVEL KEY ──────────────────────────────────────────────────
# Generar con: php artisan key:generate
APP_KEY=base64:AQUI_VA_LA_KEY_GENERADA_AUTOMATICAMENTE

# ─── BASE DE DATOS ────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=tu_usuario_cpap_db
DB_USERNAME=tu_usuario_cpap
DB_PASSWORD=tu_contrasena_segura

# ─── CACHE Y SESSION ──────────────────────────────────────────────
CACHE_DRIVER=file
SESSION_DRIVER=database
QUEUE_CONNECTION=sync

# ─── LOGS ─────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=error
# En producción usa 'error' para reducir escrituras

# ─── MAIL ─────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mail.tu-hosting.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=tu@tu-dominio.com
MAIL_PASSWORD=tu_contrasena_email
MAIL_FROM_ADDRESS=tu@tu-dominio.com
MAIL_FROM_NAME="${APP_NAME}"

# ─── AWS (si usas S3 para storage) ────────────────────────────────
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=

# DESCOMENTA solo si usas S3

# ─── PUSHER (si usas websockets) ──────────────────────────────────
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_SCHEME=https
# PUSHER_APP_CLUSTER=

# DESCOMENTA solo si usas Pusher

# ─── VITE (Assets) ────────────────────────────────────────────────
VITE_API_BASE_URL=${APP_URL}

# ─── LOCALE ───────────────────────────────────────────────────────
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

# ─── SEGURIDAD ────────────────────────────────────────────────────
APP_CIPHER=AES-256-CBC
# Asegurate que tu servidor tiene OpenSSL y soporta AES-256

# ─── NOTES PARA PRODUCCIÓN ────────────────────────────────────────
# 1. NUNCA hagas push de este archivo a git con valores reales
# 2. Después de copiar a .env, ejecuta: chmod 600 .env
# 3. Verifica las credenciales de BD antes de hacer migrate
# 4. Para email, usa cuentas dedicadas del hosting (no tu email personal)
# 5. Cambia APP_DEBUG a false SIEMPRE en producción
# 6. Ejecuta php artisan config:cache después de cambiar .env
